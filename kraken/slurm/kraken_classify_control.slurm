#!/bin/bash
#SBATCH --job-name=kraken_control
#SBATCH --account=pawsey1168
#SBATCH --partition=work
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=24G
#SBATCH --time=24:00:00
#SBATCH --output=/scratch/pawsey1168/llenzo/crypt/kraken/slurm/logs/kraken_control_%j.out
#SBATCH --error=/scratch/pawsey1168/llenzo/crypt/kraken/slurm/logs/kraken_control_%j.err

# Classify 2,473 stratified control runs against the pathogen-only DB.
# Run list generated by kraken/control/sample.py (fungi + oomycetes only, no hosts).
#
# Run from crypt/ on Setonix:
#   sbatch kraken/slurm/kraken_classify_control.slurm

set -euo pipefail

SCRATCH="/scratch/pawsey1168/llenzo"
CRYPT="$SCRATCH/crypt"
DB_DIR="$SCRATCH/kraken/db_pathogens"

module load python/3.11.6
module load spack/0.23.1
spack load kraken2

cd "$CRYPT"
mkdir -p kraken/slurm/logs

echo "Starting control classification (2473 runs): $(date)"
echo "DB: $DB_DIR"

python kraken/classify.py \
    --run-list kraken/control/output/data/run_ids.txt \
    --db "$DB_DIR" \
    --out-dir kraken/output/classify_control \
    --workers 8 \
    --kraken-threads 4 \
    --tmp-dir "$SCRATCH/kraken_tmp"

echo "Classification complete: $(date)"
