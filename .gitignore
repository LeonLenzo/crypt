# Large STAT cache — 2.4 GB, auto-fetched by stat/stat_fetch.py (all of
# stat_fetch/data/ is fetch-stage cache/checkpoints; stat_filter/data/ holds
# the actual final outputs — runs.tsv etc. — and stays tracked)
stat/output/stat_fetch/data/*

# Intermediate confirmed-run caches — regeneratable from stat_cache
stat/output/stat_filter/data/*_confirmed.json

# Large species distribution table (38k rows)
stat/output/stat_filter/data/*_species_dist.tsv

# Reference DB source files — auto-downloaded by stat/stat_build.py
stat/output/stat_build/data/phi-base_current.csv
stat/output/stat_build/data/ictv_vmr.xlsx

# meta_search.py raw API response caches — regeneratable; bioprojects.json/
# biosamples.json (the curated output, not a raw cache) stay tracked
metadata/output/meta_search/data/bp_cache.json
metadata/output/meta_search/data/bs_cache.json
metadata/output/meta_search/data/serper_cache.json

# meta_text.py: manually-downloaded copyrighted journal PDFs (715MB+, and not
# ours to redistribute) — never committed. text_cache.jsonl (the extracted
# plain text meta_classify.py actually reads) stays tracked; its .bak sibling
# is working-copy cruft, also excluded.
metadata/output/meta_text/data/manual_pdfs/
metadata/output/meta_text/data/text_cache.jsonl.bak

# Legacy (superseded) API caches + large data outputs — scripts kept for
# history under legacy/, but their large data outputs are fully superseded by
# the current pipeline's near-identical equivalents (meta_search/meta_text/
# meta_classify) — no value in carrying both as tracked multi-MB blobs.
metadata/legacy/output/fetch_lit/data/lit_cache.json
metadata/legacy/output/fetch_lit/data/literature.json
metadata/legacy/output/llm_classify/data/classify_cache.jsonl
metadata/legacy/output/fetch_xml/data/biosample_cache.json
metadata/legacy/output/ncbi_metadata/data/bp_cache.json
metadata/legacy/output/ncbi_metadata/data/bs_cache.json
metadata/legacy/output/ncbi_metadata/data/bioprojects.json
metadata/legacy/output/filter_kw/data/biosample_kw.tsv

# classify_metadata.py output — superseded by meta_classify.py's samples.tsv
# (classify_metadata.py itself not yet moved to legacy/ — separate, low
# priority cleanup — but its stale output shouldn't be carried as a tracked
# duplicate of the current samples.tsv either)
metadata/output/classify_metadata/data/samples.tsv

# Timestamped log history dirs + .latest symlinks — auto-generated, local
stat/output/stat_build/logs/history/
stat/output/stat_build/logs/*.latest
stat/output/stat_fetch/logs/history/
stat/output/stat_fetch/logs/*.latest
stat/output/stat_filter/logs/history/
stat/output/stat_filter/logs/*.latest
