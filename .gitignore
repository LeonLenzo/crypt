# Large STAT cache — 1.9 GB, auto-fetched by stat/fetch_runs.py
stat/output/fetch_runs/data/stat_cache.jsonl
stat/output/fetch_runs/data/stat_cache_index.txt

# SRA run/UID caches — auto-fetched by stat/fetch_runs.py
stat/output/fetch_runs/data/*_runs.json
stat/output/fetch_runs/data/*_uids.json

# Intermediate confirmed-run caches — regeneratable from stat_cache
stat/output/filter_runs/data/*_confirmed.json

# Large species distribution table (38k rows)
stat/output/filter_runs/data/*_species_dist.tsv

# Reference DB source files — auto-downloaded by stat/build.py
stat/output/build/data/phi-base_current.csv
stat/output/build/data/ictv_vmr.xlsx

# Literature Entrez cache — bootstraps metadata/fetch_lit.py on re-run
metadata/output/fetch_lit/data/lit_cache.json

# LLM classification cache — append-only API response log
metadata/output/llm_classify/data/classify_cache.jsonl

# BioSample XML intermediate fetch cache — regeneratable by metadata/fetch_xml.py
metadata/output/fetch_xml/data/biosample_cache.json

# Timestamped log history dirs + .latest symlinks — auto-generated, local
