# Large STAT cache — 1.9 GB, auto-fetched by stat/fetch_runs.py
stat/output/data/stat_cache.jsonl
stat/output/data/stat_cache_index.txt

# SRA run/UID caches — auto-fetched by stat/fetch_runs.py
stat/output/data/*_runs.json
stat/output/data/*_uids.json

# Intermediate confirmed-run caches — regeneratable from stat_cache
stat/output/data/*_confirmed.json

# Large species distribution table (38k rows)
stat/output/data/*_species_dist.tsv

# Literature Entrez cache — bootstraps metadata/fetch_lit.py on re-run
metadata/output/data/lit_cache.json

# LLM classification cache — append-only API response log
metadata/output/data/classify_cache.jsonl

# BioSample XML intermediate fetch cache — regeneratable by metadata/fetch_xml.py
metadata/output/data/biosample_cache.json

# Timestamped log history dirs + .latest symlinks — auto-generated, local
stat/output/logs/history/
stat/output/logs/*.latest
metadata/output/logs/history/
metadata/output/logs/*.latest
kraken/output/logs/history/
kraken/output/logs/*.latest

# Reference DB source files — auto-downloaded by stat/build.py
stat/output/data/phi-base_current.csv
stat/output/data/ictv_vmr.xlsx

# Legacy pipeline outputs
output/legacy/

# Claude Code project settings
.claude/

# Python
__pycache__/
*.pyc
*.pyo
.env

# Kraken2 large files (reproducible, not tracked)
kraken/pilot/kallisto/indices/
kraken/pilot/kallisto/quant/
kraken/pilot/kallisto/reads/
kraken/pilot/kraken/kraken_db/
kraken/pilot/kraken/reads/
kraken/db/
kraken/cds_from_genomic/
scripts/diagnostics/*.log
