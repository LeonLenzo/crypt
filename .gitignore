metadata/output/meta_search/logs/*.latest
metadata/output/meta_text/logs/history/
metadata/output/meta_text/logs/*.latest
metadata/output/meta_classify/logs/history/
metadata/output/meta_classify/logs/*.latest
kraken/output/classify/logs/history/
kraken/output/classify/logs/*.latest
kraken/output/download/logs/history/
kraken/output/download/logs/*.latest
kraken/output/kraken_db_search/logs/history/
kraken/output/kraken_db_search/logs/*.latest
kraken/output/kraken_db_busco/logs/history/
kraken/output/kraken_db_busco/logs/*.latest
kraken/output/kraken_db_build/logs/history/
kraken/output/kraken_db_build/logs/*.latest
kraken/slurm/logs/
