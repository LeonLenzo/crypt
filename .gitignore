/busco_*.log
busco_downloads/

# Kraken2 classify cache — large, regeneratable on Setonix
kraken/output/classify/data/kraken_cache*.jsonl
kraken/output/classify/data/kraken_cache*.txt
kraken/output/classify/data/reports/
kraken/output/classify/data/reports_v1/

# Old output/ directory — local pipeline data, all superseded by module layout
/output/

# Claude Code project settings
.claude/
CLAUDE.md

# Colleague correspondence / external documents
kristina/

